DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datastream_matrix
POSTGRES_USER=datastream_user
POSTGRES_PASSWORD=change-me

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

MONGODB_ROOT_USERNAME=mongo_user
MONGODB_ROOT_PASSWORD=change-me
MONGODB_URI=mongodb://mongo_user:change-me@mongodb:27017
MONGODB_DATABASE=datastream_matrix

DATASET_UPLOAD_RETENTION_HOURS=24





CSRF_TRUSTED_ORIGINS=https://your-domain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
